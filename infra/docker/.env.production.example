# LIS 프로덕션 환경변수 — 복사: cp .env.production.example .env  (같은 폴더)
# docker compose -f docker-compose.prod.yml --env-file .env ...

# DB 비밀번호(강력한 값으로 교체) — 미설정 시 compose가 기동을 거부한다(약한 기본값 폴백 제거)
DB_PASSWORD=change-me-strong

# JWT 서명 시크릿(필수, 무작위 긴 문자열)
JWT_SECRET=change-me-with-openssl-rand-hex-32

# 공개 오리진(CORS) — 도메인 확정 후
PUBLIC_ORIGIN=https://lis.example.org

# ── 개시일 주입(운영자) ───────────────────────────────────────────────
# 위험치 실통보 채널 — 미설정 시 webhook 미발화(환자안전). 개시 전 필수.
#   https만 허용(환자명+검사값이 나가는 경로). 원내 http 게이트웨이가 불가피하면 ALLOW_HTTP=on 명시.
CRITICAL_WEBHOOK_URL=
#   수신측이 통보 진위를 검증하도록 HMAC 서명(x-lis-signature) — 설정 권장
CRITICAL_WEBHOOK_SECRET=
#   CRITICAL_WEBHOOK_ALLOW_HTTP=on   (평문 채널 명시 승인 시에만)
#   CRITICAL_WEBHOOK_FULL_NAME=on    (기본은 환자명 마스킹 홍*동 — 전체 이름이 꼭 필요할 때만)
# 연계 운영 감시(DLQ/stuck) — 임상 채널과 분리
OPS_WEBHOOK_URL=

# HIS 연계(자격 수령 후) — A-3 결재 후 운영 자격으로 교체
HIS_FHIR_BASE=
HIS_FHIR_TOKEN_URL=
HIS_CLIENT_ID=
HIS_CLIENT_SECRET=
HIS_FHIR_SCOPES=
HIS_ORDER_POLL=
HIS_REFLEX_POLL=
HIS_REFLEX_RETRY=

# HIS 참조 어댑터(조직게이트 결재·수혈 동의) — 시크릿 교환 후 주입.
# 미주입 시 어댑터는 fail-safe로 "미구성" 응답(차단·크래시 없음).
# BASE 생략 시 HIS_FHIR_BASE의 origin에서 자동 유도.
HIS_INTEGRATION_BASE=
HIS_INTEGRATION_KEY=

# 보존기간 퍼지 크론(C8) — 법무 확정 전까지 비워둘 것(=미실행). 확정 후 'on'.
LIFECYCLE_PURGE=

# 리버스 프록시 신뢰 홉 수(기본 1 = nginx 1대). 레이트리밋·감사로그 IP 정확도에 직결 —
# 프록시 단이 늘면 그 수만큼 올릴 것.
TRUST_PROXY_HOPS=

# 데모 계정 패널(파일럿 전용) — 실 진료 개시 시에는 반드시 비워두고 web 재빌드.
NEXT_PUBLIC_DEMO=
