# LIS API 환경변수 (복사: cp .env.example .env)
DATABASE_URL="postgresql://lis:CHANGE_ME@localhost:5433/lis?schema=public"
PORT=4100
CORS_ORIGIN="http://localhost:3100"
JWT_SECRET="CHANGE_ME"
JWT_EXPIRES="8h"
# PACS 연계(자격증명 수령 후 설정 — R1~R3)
# PACS_BASE="https://his.example.org"     # PACS 파일럿(svc-lis)
# PACS_USER="svc-lis"
# PACS_PASS=""
# PACS_MLLP_HOST="" 
# PACS_MLLP_PORT=2575
# HIS FHIR 연계(HIS 발급 자격증명 수령 후 설정)
# HIS_FHIR_BASE="https://his.example.org/fhir/R4"
# HIS_FHIR_TOKEN_URL="https://his.example.org/oauth2/token"
# HIS_CLIENT_ID=""
# HIS_CLIENT_SECRET=""
# HIS_ORDER_POLL="on"  # HIS 오더 폴링 활성(자격증명 설정 후)
